# ─────────────────────────────────────────────────────────────
#  Пример конфигурации. Скопируйте в .env и заполните секреты.
#  Файл .env в git НЕ попадает.
# ─────────────────────────────────────────────────────────────

# ── Приложение ───────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# ── PostgreSQL ───────────────────────────────────────────────
# Рабочее подключение API — роль с минимальными правами (ht_app)
DATABASE_URL=postgresql://ht_app:CHANGE_ME@127.0.0.1:5432/habit_tracker?schema=public

# Подключение для миграций — владелец схемы (ht_owner)
MIGRATE_DATABASE_URL=postgresql://ht_owner:CHANGE_ME@127.0.0.1:5432/habit_tracker?schema=public

# Служебные параметры для скриптов сопровождения
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=habit_tracker
PG_OWNER_USER=ht_owner
PG_OWNER_PASSWORD=CHANGE_ME
PG_APP_USER=ht_app
PG_APP_PASSWORD=CHANGE_ME
PG_READONLY_USER=ht_readonly
PG_READONLY_PASSWORD=CHANGE_ME
PG_BACKUP_USER=ht_backup
PG_BACKUP_PASSWORD=CHANGE_ME

# ── Аутентификация ───────────────────────────────────────────
# Минимум 32 символа. Сгенерируйте случайные значения.
JWT_ACCESS_SECRET=change-me-please-32-characters-min
JWT_REFRESH_SECRET=change-me-please-32-characters-min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Резервное копирование ────────────────────────────────────
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=14

# ── Администрирование PostgreSQL ─────────────────────────────
# Суперпользователь используется только скриптами обслуживания.
# API работает под ролью ht_app и суперпользователя не знает.
PG_SUPERUSER_USER=postgres
PG_SUPERUSER_PASSWORD=CHANGE_ME

